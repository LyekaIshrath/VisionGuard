# VisionGuard SaaS Environment Configuration Template
# DO NOT COMMIT REAL CREDENTIALS. Copy this file to .env and supply your values.

# Supabase Project Configuration
SUPABASE_URL=https://your-project-id.supabase.co
SUPABASE_ANON_KEY=your-anon-key-here
SUPABASE_JWT_SECRET=your-supabase-jwt-secret-here

# Backend Privileged Key (BACKEND ONLY - NEVER EXPOSE TO FRONTEND)
SUPABASE_SERVICE_ROLE_KEY=your-service-role-key-here

# Frontend Environment Variables (Safe for browser)
VITE_SUPABASE_URL=https://your-project-id.supabase.co
VITE_SUPABASE_ANON_KEY=your-anon-key-here
