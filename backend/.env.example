# ====================================================================
# VisionGuard — Environment Configuration Template
# Copy this file to '.env' in root and/or 'backend/.env'
# DO NOT COMMIT SENSITIVE VALUES OR PRODUCTION CREDENTIALS
# ====================================================================

# --- Database & Storage (MongoDB) ---
# Required: Connection string to MongoDB instance (e.g., mongodb://localhost:27017)
MONGODB_URI=
# Optional: Database name (default: visionguard)
MONGODB_DATABASE=

# --- Authentication & Security ---
# Required: Random secret string (minimum 32 characters) for signing HS256 JWT tokens
JWT_SECRET=
# Optional: Algorithm for JWT signatures (default: HS256)
JWT_ALGORITHM=
# Optional: Access token expiration in minutes (default: 1440 = 24 hours)
ACCESS_TOKEN_EXPIRE_MINUTES=

# --- Server & CORS Settings ---
# Optional: Enable verbose logging / debug mode (true/false, default: false)
DEBUG=
# Optional: Additional allowed origins for CORS, comma-separated (e.g., http://localhost:5173)
CORS_ALLOWED_ORIGINS=


# --- Web Push & VAPID Notifications (Optional) ---
# Optional: VAPID keys for browser push notifications
VAPID_CLAIMS_SUB=
VAPID_PUBLIC_KEY=
VAPID_PRIVATE_KEY=
