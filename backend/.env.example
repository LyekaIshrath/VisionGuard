# VisionGuard Backend Environment Configuration Template
# DO NOT COMMIT REAL CREDENTIALS. Copy to backend/.env

# Supabase API & Auth
SUPABASE_URL=https://your-project-id.supabase.co
SUPABASE_ANON_KEY=your-anon-key-here
SUPABASE_JWT_SECRET=your-supabase-jwt-secret-here

# Backend Privileged Service Role Key (NEVER SEND TO CLIENT / REACT FRONTEND)
SUPABASE_SERVICE_ROLE_KEY=your-service-role-key-here
